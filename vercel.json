{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api(?:/|$)|.*\\.(?:js|css|svg|png|jpg|jpeg|gif|webp|avif|ico|pdf|woff|woff2|ttf|otf|eot|txt|json|map)$).*)",
      "destination": "/index.html"
    }
  ]
}
